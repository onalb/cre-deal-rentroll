{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:226721156429:repository/cre-deal-rentroll",
        "arn:aws:ecr:us-east-1:226721156429:repository/cre-deal-rentroll-agentcore",
        "arn:aws:ecr:us-east-1:226721156429:repository/capabilities-gateway"
      ]
    },
    {
      "Sid": "AppRunner",
      "Effect": "Allow",
      "Action": [
        "apprunner:DescribeService",
        "apprunner:ListOperations",
        "apprunner:UpdateService"
      ],
      "Resource": [
        "arn:aws:apprunner:us-east-1:226721156429:service/cre-deal-rentroll/e02e2828860543edbb0e3a23f6d92ebb",
        "arn:aws:apprunner:us-east-1:226721156429:service/capabilities-gateway/75e822543ff74527a621e654e17e24ad"
      ]
    },
    {
      "Sid": "LambdaCode",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode"
      ],
      "Resource": "arn:aws:lambda:us-east-1:226721156429:function:cre-deal-rentroll-gateway"
    },
    {
      "Sid": "AgentCore",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:UpdateAgentRuntime",
        "bedrock-agentcore:UpdateGatewayTarget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRuntimeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::226721156429:role/CreDealRentrollAgentCoreRuntime",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    }
  ]
}
