OPENAI_API_KEY=
# Folder that holds uploaded rent-roll CSVs (defaults to Desktop ML Interview)
CRE_RENTROLL_ROLLS_DIR=
CRE_RENTROLL_OFFLINE=0
NOMINATIM_USER_AGENT=cre-deal-rentroll/0.1 (interview demo)
# Judge Lambda. Handler: cre_rentroll.score_gcr_lambda.handler
# Event: {"query", "draft", "roll", "traces"}. It calls live_judge.
# Unset (or blank) calls that handler in this process. Local docker and pytest
# leave it unset and do not need AWS. Do not send score_gcr through the
# capabilities gateway, and do not set this to TOOLS_LAMBDA_ARN. Username,
# as-of, HITL, search-fail, and the question stay in this process.
# SCORE_GCR_LAMBDA_ARN=
# Required for capability tools and for skill markdown.
# Skills are GET {URL}/skills/{name}. This repo does not contain those files.
# Unset makes those tools error and skill load fail.
CAPABILITIES_GATEWAY_URL=http://127.0.0.1:8010
